# =============================================================================
# EcoSort AI - Environment Variables
# =============================================================================

# GEMINI_API_KEY: Required for multimodal vision waste analysis & AI chat.
# In Vercel: Add this under Project Settings -> Environment Variables.
# In Local: Copy this file to .env and insert your Gemini API Key from Google AI Studio.
# https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# ML_SERVICE_URL: (Optional) Local or remote Python FastAPI ML inference microservice.
# Defaults to http://127.0.0.1:8000 if not set.
ML_SERVICE_URL=http://127.0.0.1:8000
