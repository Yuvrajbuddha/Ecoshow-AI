# GEMINI_API_KEY: Required for secure server-side Gemini AI API calls.
# Google AI Studio automatically injects this at runtime from user secrets.
# Never expose this key to client-side code or browser bundles.
GEMINI_API_KEY=

# APP_URL: The URL where this applet is hosted.
# Google AI Studio automatically injects this at runtime with the Cloud Run service URL.
APP_URL=
