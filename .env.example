# =============================================================================
# EcoSort AI - Environment Variables
# =============================================================================

# GEMINI_API_KEY: Required for multimodal vision waste analysis & AI chat.
# In Vercel: Add this under Project Settings -> Environment Variables.
# In Local: Copy this file to .env and insert your Gemini API Key from Google AI Studio.
# https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# ML_SERVICE_URL: (Optional) Local or remote Python FastAPI ML inference microservice.
# Defaults to http://127.0.0.1:8000 if not set.
ML_SERVICE_URL=http://127.0.0.1:8000

# =============================================================================
# IBM AI & watsonx.ai Configuration (Optional - Local Granite Engine works out of the box)
# =============================================================================
# IBM_WATSONX_APIKEY: IBM Cloud IAM API Key for watsonx.ai foundation models.
IBM_WATSONX_APIKEY=

# IBM_WATSONX_PROJECT_ID: Your IBM watsonx.ai Project ID.
IBM_WATSONX_PROJECT_ID=

# IBM_WATSONX_URL: Regional IBM watsonx endpoint (defaults to https://us-south.ml.cloud.ibm.com).
IBM_WATSONX_URL=https://us-south.ml.cloud.ibm.com

# IBM_GRANITE_MODEL_ID: IBM Granite model ID (defaults to ibm/granite-3-8b-instruct).
IBM_GRANITE_MODEL_ID=ibm/granite-3-8b-instruct
